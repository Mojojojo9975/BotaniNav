# backend/.env.example
#
# Copy this to .env and fill in your values:
#   cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./botanicnav.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/botanicnav

# ── Auth ──────────────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys.
# The Flutter app sends this in the X-API-Key header.
API_KEYS=dev-key,your-production-key-here

# ── Google Maps ───────────────────────────────────────────────────────────────
# Required for POST /api/v1/navigation/route (Google Directions API).
# Same key as in the Flutter app's .env file.
GOOGLE_MAPS_API_KEY=

# ── External plant database ──────────────────────────────────────────────────
# Puutarhakanta API — used by seed.py to populate the plant catalogue.
PLANT_DB_BASE_URL=https://puutarhakanta-api.onrender.com

# ── Navigation tuning ────────────────────────────────────────────────────────
# How close (metres) the user must be to trigger arrival.
ARRIVAL_THRESHOLD_METRES=5.0

# How often (seconds) the WebSocket pushes navigation updates.
WS_PUSH_INTERVAL_SECONDS=2.0
